---
const presets = [
  "pve1.example.com",
  "prod root@10.0.0.5",
  "debian@pve1.example.com:2222",
  "ops admin@[2001:db8::10]:2222",
  "deploy v1.2 server",
  "ansible",
  "old box [nobwsshd]",
];
---

<section id="naming" class="section dots" aria-labelledby="naming-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Naming convention</span>
      <h2 id="naming-title">Name the key. Get the config.</h2>
      <p class="lead">
        The first token shaped like <code class="inline-code">[user@]host[:port]</code> in the Bitwarden item name becomes
        the target. Version-like tokens are ignored, and <code class="inline-code">[nobwsshd]</code> opts a key out.
        <strong class="try">Type a name below and watch the config follow.</strong>
      </p>
    </div>

    <div class="play" data-play-root>
      <div class="left">
        <div class="field" data-field>
          <div class="field-head">
            <label for="keyname">Bitwarden item name</label>
            <span class="live"><span class="dot" aria-hidden="true"></span>Live</span>
          </div>
          <div class="input-wrap">
            <svg class="pen" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
              ><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg
            >
            <input
              id="keyname"
              type="text"
              value="debian@pve1.example.com:2222"
              placeholder="Type a Bitwarden item name"
              spellcheck="false"
              autocomplete="off"
              aria-describedby="keyname-hint"
              data-name
            />
          </div>
          <p id="keyname-hint" class="hint" data-hint>Click and type your own, the demo stops.</p>
        </div>

        <div class="block">
          <span class="block-title">How bwsshd reads it</span>
          <div class="tokens" data-tokens aria-live="polite"></div>
          <div class="legend" aria-hidden="true">
            <span><i class="sw user"></i>user</span>
            <span><i class="sw host"></i>host</span>
            <span><i class="sw port"></i>port</span>
            <span><i class="sw ignored"></i>ignored</span>
          </div>
        </div>

        <div class="block">
          <span class="block-title">Or try one</span>
          <div class="presets">
            {presets.map((p) => <button type="button" data-preset={p}>{p}</button>)}
          </div>
        </div>
      </div>

      <figure class="file">
        <figcaption>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
            ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg
          >
          ~/.ssh/config.automatic.bw
        </figcaption>
        <pre data-out></pre>
      </figure>
    </div>
  </div>
</section>

<script>
  import { looksLikeHost, parseTarget, sanitize, skipKey } from "../naming";

  const root = document.querySelector<HTMLElement>("[data-play-root]")!;
  const input = root.querySelector<HTMLInputElement>("[data-name]")!;
  const field = root.querySelector<HTMLElement>("[data-field]")!;
  const hint = root.querySelector<HTMLElement>("[data-hint]")!;
  const out = root.querySelector<HTMLElement>("[data-out]")!;
  const tokens = root.querySelector<HTMLElement>("[data-tokens]")!;

  const el = (tag: string, cls: string, text = "") => {
    const e = document.createElement(tag);
    e.className = cls;
    e.textContent = text;
    return e;
  };

  /** One chip per word of the name, showing the role bwsshd gives it. */
  function renderTokens(name: string) {
    const t = parseTarget(name);
    let matched = false;
    const chips: HTMLElement[] = [];
    for (const word of name.split(/\s+/).filter(Boolean)) {
      if (word.includes("[nobwsshd]")) {
        chips.push(el("span", "tok skip", word));
        continue;
      }
      const trimmed = word.replace(/^\.+|\.+$/g, "");
      const isTarget =
        !matched && t && (trimmed === t.host || trimmed.endsWith(`@${t.host}`) || trimmed.includes(`${t.host}:`) || trimmed.includes(`[${t.host}]`));
      if (!isTarget || !t) {
        const version = /\d/.test(word) && word.includes(".") && !looksLikeHost(trimmed);
        const chip = el("span", "tok ignored", word);
        chip.title = version ? "looks like a version, ignored" : "not a host, ignored";
        chips.push(chip);
        continue;
      }
      matched = true;
      const chip = el("span", "tok target");
      if (t.user !== undefined) {
        chip.append(el("span", "user", t.user), el("span", "sep", "@"));
      }
      const v6 = t.port && trimmed.includes(`[${t.host}]`);
      chip.append(el("span", "host", v6 ? `[${t.host}]` : t.host));
      if (t.port) chip.append(el("span", "sep", ":"), el("span", "port", t.port));
      chips.push(chip);
    }
    if (!chips.length) chips.push(el("span", "tok empty", "waiting for a name"));
    tokens.replaceChildren(...chips);
  }

  let previous: string[] = [];

  function render() {
    const name = input.value;
    const lines: [string, string, string][] = [];
    const t = parseTarget(name);
    if (skipKey(name)) {
      lines.push(["", "# skipped: the name contains [nobwsshd]", "c"]);
    } else if (!t) {
      const file = `${sanitize(name) || "key"}.pub`;
      lines.push(["", "# Keys with no hostname in their Bitwarden name. Add a manual Host", "c"]);
      lines.push(["", "# block referencing the .pub below:", "c"]);
      lines.push(["", `#   ${JSON.stringify(name)} -> ~/.ssh/bwsshd-keys/${file}`, "c"]);
    } else {
      lines.push(["Host ", t.host, "host"]);
      lines.push(["    HostName ", t.host, "host"]);
      if (t.user !== undefined) lines.push(["    User ", t.user, "user"]);
      if (t.port) lines.push(["    Port ", t.port, "port"]);
      lines.push(["    IdentityAgent ", "~/.bitwarden-ssh-agent.sock", "v"]);
      lines.push(["    IdentityFile ", `~/.ssh/bwsshd-keys/${sanitize(t.host)}.pub`, "v"]);
      lines.push(["    IdentitiesOnly ", "yes", "v"]);
    }

    const now = lines.map(([k, v]) => k + v);
    out.replaceChildren(el("span", "line c", "# Generated by bwsshd. Do not edit; changes are overwritten.\n\n"));
    lines.forEach(([k, v, cls], i) => {
      const line = el("span", "line");
      if (k) line.append(el("span", "k", k));
      line.append(el("span", cls, `${v}\n`));
      if (previous.length && previous[i] !== now[i]) line.classList.add("changed");
      out.append(line);
    });
    previous = now;
    renderTokens(name);
  }

  // A typing demo runs until the visitor touches the field, so the section
  // shows it reacts to every keystroke.
  const demo = [
    "debian@pve1.example.com:2222",
    "prod root@10.0.0.5",
    "ops admin@[2001:db8::10]:2222",
    "deploy v1.2 server",
    "backup box [nobwsshd]",
  ];
  let demoOn = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let timer = 0;

  const stopDemo = () => {
    if (!demoOn) return;
    demoOn = false;
    clearTimeout(timer);
    field.classList.remove("demo");
    hint.textContent = "Every keystroke updates the config on the right.";
  };

  function runDemo(i = 0) {
    if (!demoOn) return;
    field.classList.add("demo");
    const target = demo[i % demo.length];
    const step = (text: string, typing: boolean) => {
      if (!demoOn) return;
      input.value = text;
      render();
      if (typing && text.length < target.length) {
        timer = window.setTimeout(() => step(target.slice(0, text.length + 1), true), 55 + Math.random() * 45);
      } else if (typing) {
        timer = window.setTimeout(() => step(text, false), 1800);
      } else if (text.length > 0) {
        timer = window.setTimeout(() => step(text.slice(0, -1), false), 22);
      } else {
        timer = window.setTimeout(() => runDemo(i + 1), 350);
      }
    };
    step(input.value === target ? target : "", input.value !== target);
  }

  input.addEventListener("input", () => {
    stopDemo();
    render();
  });
  for (const ev of ["focus", "pointerdown"]) input.addEventListener(ev, stopDemo);
  for (const b of root.querySelectorAll<HTMLButtonElement>("[data-preset]")) {
    b.addEventListener("click", () => {
      stopDemo();
      input.value = b.dataset.preset ?? "";
      render();
    });
  }
  render();

  if (demoOn) {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      timer = window.setTimeout(() => runDemo(0), 900);
    });
    io.observe(root);
  } else {
    hint.textContent = "Every keystroke updates the config on the right.";
  }
</script>

<style>
  .try {
    display: block;
    margin-top: 10px;
    color: var(--text);
    font-weight: 600;
  }
  .play {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }
  .left {
    flex: 1 1 400px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .field {
    padding: 18px;
    border-radius: var(--radius);
    border: 1px solid var(--signal-deep);
    background: linear-gradient(180deg, rgba(79, 227, 200, 0.07), rgba(79, 227, 200, 0.02));
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .field-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  label {
    font: 13px var(--font-mono);
    color: var(--soft);
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 600 11px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--signal);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }
  .input-wrap {
    position: relative;
  }
  .pen {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--signal);
    pointer-events: none;
  }
  input {
    width: 100%;
    min-height: 60px;
    padding: 0 16px 0 46px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--ground);
    color: var(--text);
    font: 17px var(--font-mono);
    caret-color: var(--signal);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  input::placeholder {
    color: var(--faint);
  }
  input:hover {
    border-color: #33405f;
  }
  input:focus {
    outline: none;
    border-color: var(--signal);
    box-shadow: 0 0 0 4px rgba(79, 227, 200, 0.15);
  }
  .field.demo input {
    animation: invite 2.4s ease-in-out infinite;
  }
  @keyframes invite {
    50% {
      border-color: var(--signal-deep);
      box-shadow: 0 0 0 4px rgba(79, 227, 200, 0.08);
    }
  }
  .hint {
    font-size: 13px;
    color: var(--muted);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .block-title {
    font: 11px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .tokens {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-height: 34px;
  }
  .tokens :global(.tok) {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 8px;
    font: 14px var(--font-mono);
    border: 1px solid var(--line);
    background: var(--panel);
    animation: pop 0.18s ease-out;
  }
  @keyframes pop {
    from {
      transform: translateY(3px);
      opacity: 0.4;
    }
  }
  .tokens :global(.ignored) {
    color: var(--faint);
    border-style: dashed;
    text-decoration: line-through;
    text-decoration-color: rgba(125, 135, 163, 0.6);
  }
  .tokens :global(.skip) {
    color: var(--reject);
    border-color: var(--reject-deep);
  }
  .tokens :global(.target) {
    border-color: var(--signal-deep);
    background: rgba(79, 227, 200, 0.06);
  }
  .tokens :global(.empty) {
    color: var(--faint);
    border-style: dashed;
  }
  .tokens :global(.sep) {
    color: var(--faint);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font: 12px var(--font-mono);
    color: var(--muted);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sw {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }
  .sw.ignored {
    border: 1px dashed var(--faint);
  }

  /* Shared role colors: the token chips and the config lines use the same. */
  .play :global(.user) {
    color: #c3b5ff;
  }
  .play :global(.host) {
    color: var(--signal);
  }
  .play :global(.port) {
    color: #7cc4ff;
  }
  .sw.user {
    background: #c3b5ff;
  }
  .sw.host {
    background: var(--signal);
  }
  .sw.port {
    background: #7cc4ff;
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .presets button {
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    font: 12px var(--font-mono);
    cursor: pointer;
  }
  .presets button:hover {
    color: var(--text);
    border-color: #33405f;
  }

  .file {
    flex: 1 1 480px;
    min-width: 0;
    margin: 0;
    align-self: flex-start;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--hairline);
    background: var(--surface);
    font: 12px var(--font-mono);
    color: var(--muted);
  }
  pre {
    margin: 0;
    padding: 20px;
    font-size: 14px;
    line-height: 1.8;
    min-height: 17em;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  pre :global(.line) {
    display: block;
    border-radius: 4px;
  }
  pre :global(.changed) {
    animation: flash 0.7s ease-out;
  }
  @keyframes flash {
    from {
      background: rgba(79, 227, 200, 0.16);
    }
  }
  pre :global(.k) {
    color: var(--muted);
  }
  pre :global(.v) {
    color: var(--text);
  }
  pre :global(.c) {
    color: var(--faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .dot,
    .field.demo input,
    .tokens :global(.tok),
    pre :global(.changed) {
      animation: none;
    }
  }
</style>
