---
const presets = [
  "pve1.example.com",
  "prod root@10.0.0.5",
  "debian@pve1.example.com:2222",
  "deploy v1.2 server",
  "ansible",
  "old box [nobwsshd]",
];
---

<section id="naming" class="section dots" aria-labelledby="naming-title">
  <div class="wrap grid">
    <div class="left">
      <span class="eyebrow">Naming convention</span>
      <h2 id="naming-title">Name the key. Get the config.</h2>
      <p class="lead">
        The first token shaped like <code class="inline-code">[user@]host[:port]</code> in the Bitwarden item name becomes
        the target. Version-like tokens are ignored, and <code class="inline-code">[nobwsshd]</code> opts a key out.
      </p>
      <label for="keyname">Bitwarden item name</label>
      <input id="keyname" type="text" value="debian@pve1.example.com:2222" spellcheck="false" autocomplete="off" data-name />
      <div class="presets" aria-label="Examples">
        {presets.map((p) => <button type="button" data-preset={p}>{p}</button>)}
      </div>
      <div class="fields" data-fields aria-live="polite"></div>
    </div>
    <figure class="file">
      <figcaption>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg
        >
        ~/.ssh/config.automatic.bw
      </figcaption>
      <pre data-out></pre>
    </figure>
  </div>
</section>

<script>
  import { parseTarget, sanitize, skipKey } from "../naming";

  const input = document.querySelector<HTMLInputElement>("[data-name]")!;
  const out = document.querySelector<HTMLElement>("[data-out]")!;
  const fields = document.querySelector<HTMLElement>("[data-fields]")!;

  const span = (cls: string, text: string) => {
    const s = document.createElement("span");
    s.className = cls;
    s.textContent = text;
    return s;
  };

  function render() {
    const name = input.value;
    const lines: [string, string, string?][] = [];
    const chips: [string, string, boolean][] = [];
    const t = parseTarget(name);
    if (skipKey(name)) {
      lines.push(["", "# skipped: the name contains [nobwsshd]", "c"]);
      chips.push(["skip", "[nobwsshd]", false]);
    } else if (!t) {
      const file = `${sanitize(name) || "key"}.pub`;
      lines.push(["", "# Keys with no hostname in their Bitwarden name. Add a manual Host", "c"]);
      lines.push(["", "# block referencing the .pub below:", "c"]);
      lines.push(["", `#   ${JSON.stringify(name)} -> ~/.ssh/bwsshd-keys/${file}`, "c"]);
      chips.push(["host", "none found", false]);
    } else {
      lines.push(["Host ", t.host]);
      lines.push(["    HostName ", t.host]);
      if (t.user !== undefined) lines.push(["    User ", t.user]);
      if (t.port) lines.push(["    Port ", t.port]);
      lines.push(["    IdentityAgent ", "~/.bitwarden-ssh-agent.sock"]);
      lines.push(["    IdentityFile ", `~/.ssh/bwsshd-keys/${sanitize(t.host)}.pub`]);
      lines.push(["    IdentitiesOnly ", "yes"]);
      chips.push(["host", t.host, true]);
      if (t.user !== undefined) chips.push(["user", t.user, true]);
      if (t.port) chips.push(["port", t.port, true]);
    }

    out.replaceChildren(span("c", "# Generated by bwsshd. Do not edit; changes are overwritten.\n\n"));
    for (const [k, v, cls] of lines) {
      if (k) out.append(span("k", k));
      out.append(span(cls ?? "v", `${v}\n`));
    }
    fields.replaceChildren(
      ...chips.map(([k, v, ok]) => {
        const c = span(`chip ${ok ? "ok" : "warn"}`, `${k} `);
        c.append(span("strong", v));
        return c;
      }),
    );
  }

  input.addEventListener("input", render);
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-preset]")) {
    b.addEventListener("click", () => {
      input.value = b.dataset.preset ?? "";
      render();
    });
  }
  render();
</script>

<style>
  .grid {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }
  .left {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h2 {
    font-size: clamp(30px, 4vw, 40px);
  }
  label {
    margin-top: 8px;
    font: 13px var(--font-mono);
    color: var(--muted);
  }
  input {
    min-height: 52px;
    padding: 0 16px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--text);
    font: 16px var(--font-mono);
  }
  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .presets button {
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    font: 12px var(--font-mono);
    cursor: pointer;
  }
  .presets button:hover {
    color: var(--text);
  }
  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-height: 28px;
  }
  .fields :global(.chip) {
    font: 12px var(--font-mono);
    border-radius: 999px;
    padding: 4px 12px;
  }
  .fields :global(.chip .strong) {
    font-weight: 600;
  }
  .fields :global(.ok) {
    color: var(--signal);
    border: 1px solid var(--signal-deep);
  }
  .fields :global(.warn) {
    color: var(--reject);
    border: 1px solid var(--reject-deep);
  }
  .file {
    flex: 1 1 520px;
    min-width: 0;
    margin: 0;
    align-self: flex-start;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--hairline);
    background: var(--surface);
    font: 12px var(--font-mono);
    color: var(--muted);
  }
  pre {
    margin: 0;
    padding: 20px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.8;
    min-height: 15em;
  }
  pre :global(.k) {
    color: var(--signal);
  }
  pre :global(.v) {
    color: var(--text);
  }
  pre :global(.c) {
    color: var(--faint);
  }
</style>
