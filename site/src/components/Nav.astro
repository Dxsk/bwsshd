---
import Logo from "./Logo.astro";
import { REPO } from "../site";

const links = [
  { href: "/#who", label: "Who it's for" },
  { href: "/#how", label: "How it works" },
  { href: "/#setup", label: "Setup" },
];
const path = Astro.url.pathname;
const inDocs = path.startsWith("/docs");
---

<header class="bar">
  <nav aria-label="Main" class="wrap inner">
    <a href="/" class="brand">
      <Logo />
      <span>bwsshd</span>
    </a>
    <div class="links">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) && l.href !== "/" ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </div>
    <div class="actions">
      <a class="btn-nav" href="/docs/" target="_blank" rel="noopener" aria-current={inDocs ? "page" : undefined}>Docs</a>
      <a class="btn-nav primary" href="/#install">Install</a>
      <a class="btn-nav" href={REPO} target="_blank" rel="noopener" aria-label="bwsshd on GitHub (opens in a new tab)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          ><path
            d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.7a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.2-.3-3.8 1.4a13 13 0 0 0-7 0C6.4 1.7 5.2 2 5.2 2a4.8 4.8 0 0 0-.1 3.6 5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.2 6.4 6.2 6.7a3.4 3.4 0 0 0-.9 2.6V22"
          ></path></svg
        >
        <span class="gh-label">GitHub</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(10, 13, 20, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 12px 28px;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .links {
    display: flex;
    gap: 24px;
    font-size: 14px;
  }
  .links a {
    color: var(--muted);
  }
  .links a:hover,
  .links a[aria-current="page"] {
    color: var(--text);
  }
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .btn-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 8px;
    background: var(--raised);
    border: 1px solid var(--line);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
  }
  .btn-nav:hover {
    color: var(--text);
    border-color: #33405f;
  }
  .btn-nav[aria-current="page"] {
    border-color: var(--signal-deep);
  }
  .btn-nav.primary {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
    font-weight: 600;
  }
  .btn-nav.primary:hover {
    background: #6ff0d8;
    color: var(--on-signal);
  }
  /* Section links are a desktop nicety; on narrow screens the three buttons
     carry the nav and GitHub collapses to its icon. */
  @media (max-width: 860px) {
    .links {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .gh-label {
      display: none;
    }
  }
  @media (max-width: 340px) {
    .brand span {
      display: none;
    }
  }
</style>
