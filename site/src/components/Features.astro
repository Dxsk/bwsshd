---
// The features as a bento grid: each card shows the thing itself (a config
// excerpt, the key folder, the event log...) instead of an icon and a sentence.
const sockets = [
  { os: "Linux", kind: "native", path: "~/.bitwarden-ssh-agent.sock" },
  { os: "Linux", kind: "Flatpak", path: "~/.var/app/com.bitwarden.desktop/..." },
  { os: "Linux", kind: "Snap", path: "~/snap/bitwarden/current/..." },
  { os: "macOS", kind: ".dmg", path: "~/.bitwarden-ssh-agent.sock" },
  { os: "macOS", kind: "App Store", path: "~/Library/Containers/com.bitwarden..." },
  { os: "Windows", kind: "pipe", path: "\\\\.\\pipe\\openssh-ssh-agent" },
];

const events = [
  { what: "Bitwarden opens", log: "wrote config.automatic.bw: 12 host(s)", tone: "signal" },
  { what: "A key is renamed", log: "rewrote the matching Host block", tone: "signal" },
  { what: "Nothing changed", log: "no write, files untouched", tone: "muted" },
  { what: "Bitwarden closes", log: "agent socket absent, cleared config", tone: "reject" },
];

const safety = [
  "Config and keys written 0600, key folder 0700",
  "Atomic writes: never a half-written ~/.ssh/config",
  "Only touches a folder it marked as its own",
  "Refuses symlinked key folders",
  "Refuses to run as root",
];
---

<section id="features" class="section" aria-labelledby="features-title">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Features</span>
      <h2 id="features-title">Small daemon, careful defaults.</h2>
      <p class="lead">
        A single static binary that runs as you, polls the agent, and writes three things: a config, a folder of public
        keys and one <code class="inline-code">Include</code> line.
      </p>
    </div>

    <div class="bento">
      <article class="card key">
        <div class="copy">
          <h3>One key per host</h3>
          <p>
            Every block pins a single identity with <code class="inline-code">IdentitiesOnly yes</code>. SSH offers that
            key and nothing else, so the right key is always the first one tried.
          </p>
        </div>
        <pre class="snippet"><span class="k">Host</span> pve1.example.com
    <span class="k">HostName</span> pve1.example.com
    <span class="k">User</span> debian
    <span class="k">IdentityFile</span> ~/.ssh/bwsshd-keys/pve1.example.com.pub
<span class="hl">    <span class="k">IdentitiesOnly</span> yes</span></pre>
        <div class="tally" aria-label="Authentication attempts">
          <span><strong class="signal">1</strong> attempt with bwsshd</span>
          <span><strong class="reject">every key</strong> with the agent alone</span>
        </div>
      </article>

      <article class="card disk">
        <div class="copy">
          <h3>Never on disk</h3>
          <p>Only public keys are written, to tell SSH which key to ask for. Signing stays in Bitwarden.</p>
        </div>
        <pre class="tree"><span class="dir">~/.ssh/bwsshd-keys/</span>
├─ <span class="dim">.bwsshd</span>
├─ pve1.example.com<span class="ext">.pub</span>
├─ db.example.com<span class="ext">.pub</span>
└─ ansible<span class="ext">.pub</span>
<span class="gone">id_ed25519</span>  <span class="note">stays in the vault</span></pre>
      </article>

      <article class="card watch">
        <div class="copy">
          <h3>Follows the vault</h3>
          <p>In watch mode it reacts to the vault and writes only when something changed.</p>
        </div>
        <ol class="events">
          {
            events.map((e) => (
              <li class={e.tone}>
                <span class="what">{e.what}</span>
                <span class="log">{e.log}</span>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="card agent">
        <div class="copy">
          <h3>Finds the agent on its own</h3>
          <p>
            Native, Flatpak and Snap on Linux, both macOS builds, the named pipe on Windows. Or point it anywhere
            with <code class="inline-code">--sock</code>.
          </p>
        </div>
        <ul class="sockets">
          {
            sockets.map((s) => (
              <li>
                <span class="os">
                  {s.os} <span class="kind">{s.kind}</span>
                </span>
                <code>{s.path}</code>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="card safe">
        <div class="copy">
          <h3>Safe by default</h3>
          <p>It lives in your <code class="inline-code">~/.ssh</code>, so it behaves like a guest there.</p>
        </div>
        <ul class="checks">
          {
            safety.map((s) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 12 5 5L20 7" />
                </svg>
                {s}
              </li>
            ))
          }
        </ul>
      </article>

      <article class="card backend">
        <div class="copy">
          <h3>Cloud or Vaultwarden</h3>
          <p>The agent socket comes from the desktop app, so the server behind it does not matter.</p>
        </div>
        <div class="flow" aria-label="Bitwarden cloud or Vaultwarden, then the desktop app, then bwsshd">
          <div class="sources">
            <span class="node">Bitwarden cloud</span>
            <span class="node">Vaultwarden</span>
          </div>
          <span class="arrow" aria-hidden="true"></span>
          <span class="node strong">Desktop app agent</span>
          <span class="arrow" aria-hidden="true"></span>
          <span class="node signal">bwsshd</span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }
  .card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(79, 227, 200, 0.45), transparent);
  }
  .key {
    grid-column: span 4;
  }
  .disk {
    grid-column: span 2;
  }
  .watch {
    grid-column: span 2;
  }
  .agent {
    grid-column: span 4;
  }
  .safe,
  .backend {
    grid-column: span 3;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h3 {
    font-size: 20px;
  }
  .copy p {
    color: var(--muted);
    font-size: 15px;
  }

  pre {
    margin: 0;
    padding: 16px 18px;
    border-radius: 10px;
    border: 1px solid var(--hairline);
    background: var(--ground);
    font-size: 13px;
    line-height: 1.75;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--soft);
  }
  .snippet .k {
    color: var(--muted);
  }
  .snippet .hl {
    display: block;
    margin: 0 -18px;
    padding: 0 18px;
    background: rgba(79, 227, 200, 0.1);
    box-shadow: inset 2px 0 0 var(--signal);
    color: var(--signal);
  }
  .snippet .hl .k {
    color: var(--signal);
  }
  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font: 13px var(--font-mono);
    color: var(--muted);
  }
  .signal {
    color: var(--signal);
  }
  .reject {
    color: var(--reject);
  }

  .tree {
    flex: 1 1 auto;
  }
  .tree .dir {
    color: var(--text);
  }
  .tree .dim {
    color: var(--faint);
  }
  .tree .ext {
    color: var(--signal);
  }
  .tree .gone {
    color: var(--faint);
    text-decoration: line-through;
  }
  .tree .note {
    color: var(--muted);
    font-family: var(--font-body);
    font-size: 12px;
  }

  .events {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-left: 1px solid var(--line);
  }
  .events li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .events li::before {
    content: "";
    position: absolute;
    left: -19px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 0 3px var(--panel);
  }
  .events li.signal {
    color: var(--signal);
  }
  .events li.muted {
    color: var(--faint);
  }
  .events li.reject {
    color: var(--reject);
  }
  .what {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }
  .log {
    font: 12px var(--font-mono);
    color: var(--muted);
  }

  .sockets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 8px;
  }
  .sockets li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--hairline);
    background: var(--ground);
    min-width: 0;
  }
  .os {
    font-size: 14px;
    font-weight: 600;
  }
  .kind {
    margin-left: 4px;
    font: 500 11px var(--font-mono);
    color: var(--signal);
    border: 1px solid var(--signal-deep);
    border-radius: 999px;
    padding: 1px 7px;
  }
  .sockets code {
    font-size: 12px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    color: var(--soft);
  }
  .checks li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .checks svg {
    flex: 0 0 auto;
    margin-top: 3px;
    color: var(--signal);
  }

  .flow {
    flex: 1 1 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .sources {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .node {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--ground);
    font: 13px var(--font-mono);
    color: var(--soft);
    white-space: nowrap;
  }
  .node.strong {
    color: var(--text);
    border-color: #2e3460;
    background: #151a33;
  }
  .node.signal {
    color: var(--on-signal);
    background: var(--signal);
    border-color: var(--signal);
    font-weight: 600;
  }
  .arrow {
    width: 28px;
    height: 2px;
    background: linear-gradient(90deg, var(--line), var(--signal));
    position: relative;
  }
  .arrow::after {
    content: "";
    position: absolute;
    right: -1px;
    top: -4px;
    border: 5px solid transparent;
    border-left-color: var(--signal);
    border-right: 0;
  }

  @media (max-width: 980px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .key,
    .agent {
      grid-column: span 2;
    }
    .disk,
    .watch,
    .safe,
    .backend {
      grid-column: span 1;
    }
  }
  @media (max-width: 640px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .card {
      grid-column: auto !important;
    }
    /* The flow reads top to bottom once there is no room for a row. */
    .flow {
      flex-direction: column;
      align-items: stretch;
    }
    .sources {
      flex-direction: row;
    }
    .sources .node {
      flex: 1 1 0;
    }
    .arrow {
      align-self: center;
      width: 2px;
      height: 22px;
      background: linear-gradient(180deg, var(--line), var(--signal));
    }
    .arrow::after {
      right: auto;
      top: auto;
      left: -4px;
      bottom: -1px;
      border: 5px solid transparent;
      border-top-color: var(--signal);
      border-bottom: 0;
    }
  }
</style>
