---
import { AUTHOR, REPO } from "../site";
import { VERSION } from "../version";
---

<footer>
  <div class="wrap inner">
    <div class="who">
      <span>
        <span class="name">bwsshd</span> by{" "}
        <a href={AUTHOR} target="_blank" rel="noopener">Daihyxsk</a>
      </span>
      <span class="note">
        Not affiliated with{" "}
        <a href="https://bitwarden.com/" target="_blank" rel="noopener">Bitwarden, Inc.</a>
      </span>
    </div>
    <span class="version">v{VERSION}</span>
    <nav class="links" aria-label="Footer">
      <a href="/docs/" target="_blank" rel="noopener">Docs</a>
      <a href="/changelog/">Changelog</a>
      <a href="/license/">MIT License</a>
      <a href={REPO} target="_blank" rel="noopener">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--hairline);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px 32px;
    align-items: center;
    padding-top: 32px;
    padding-bottom: 32px;
    font-size: 14px;
    color: var(--muted);
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .name {
    font-family: var(--font-mono);
    color: var(--text);
  }
  .note {
    font-size: 13px;
    color: var(--faint);
  }
  .version {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--soft);
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 24px;
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--text);
  }
  .who a {
    color: var(--soft);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .who a:hover {
    color: var(--signal);
    text-decoration-color: currentColor;
  }
  .note a {
    color: inherit;
  }

  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .version {
      order: -1;
    }
    .links {
      justify-content: center;
    }
  }
</style>
