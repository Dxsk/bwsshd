---
import { REPO } from "../site";
import { VERSION } from "../version";
---

<footer>
  <div class="wrap inner">
    <span><span class="name">bwsshd</span> by Daihyxsk</span>
    <span>v{VERSION}</span>
    <span>MIT License</span>
    <a href="/docs/" target="_blank" rel="noopener">Docs</a>
    <a href="/changelog/">Changelog</a>
    <a href={REPO} target="_blank" rel="noopener">GitHub</a>
    <span class="note">Not affiliated with Bitwarden, Inc.</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--hairline);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    align-items: center;
    padding-top: 32px;
    padding-bottom: 32px;
    font-size: 14px;
    color: var(--muted);
  }
  .name {
    font-family: var(--font-mono);
    color: var(--text);
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: var(--text);
  }
  .note {
    margin-left: auto;
    color: var(--faint);
  }
</style>
