---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SECTIONS, docsInOrder } from "../../docs";
import { REPO } from "../../site";
import ReadingHead from "../../components/ReadingHead.astro";
import ReadingSettings from "../../components/ReadingSettings.astro";

export async function getStaticPaths() {
  const docs = await docsInOrder();
  return docs.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: docs[i - 1], next: docs[i + 1], all: docs },
  }));
}

const { entry, prev, next, all } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={`${entry.data.title} | bwsshd docs`} description={entry.data.description}>
  <ReadingHead slot="head" />
  <div class="wrap docs">
    <nav aria-label="Docs" class="side">
      {
        SECTIONS.map((section) => (
          <div class="group">
            <span class="group-title">{section}</span>
            {all
              .filter((d) => d.data.section === section)
              .map((d) => (
                <a href={`/docs/${d.id}/`} aria-current={d.id === entry.id ? "page" : undefined}>
                  {d.data.title}
                </a>
              ))}
          </div>
        ))
      }
    </nav>

    <article class="content">
      <div class="topline">
        <span class="crumb">{entry.data.section} / <span>{entry.data.title}</span></span>
        <ReadingSettings />
      </div>
      <h1>{entry.data.title}</h1>
      <p class="intro">{entry.data.description}</p>
      <div class="prose">
        <Content />
      </div>
      <div class="pager">
        {
          prev ? (
            <a href={`/docs/${prev.id}/`}>
              <span>Previous</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/docs/${next.id}/`} class="next">
              <span>Next</span>
              {next.data.title}
            </a>
          )
        }
      </div>
      <a class="edit" href={`${REPO}/edit/main/site/src/content/docs/${entry.id}.md`}>Edit this page</a>
    </article>

    {
      toc.length > 1 && (
        <aside aria-label="On this page" class="toc">
          <span class="group-title">On this page</span>
          {toc.map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
        </aside>
      )
    }
  </div>
</Base>

<style>
  .docs {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    max-width: 1360px;
  }
  .side {
    flex: 1 1 220px;
    max-width: 260px;
    padding: 40px 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
    font-size: 14px;
  }
  .group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .group-title {
    font: 11px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    padding: 0 10px 6px;
  }
  .side a {
    color: var(--muted);
    padding: 6px 10px;
    border-radius: 6px;
  }
  .side a:hover {
    color: var(--text);
  }
  .side a[aria-current="page"] {
    color: var(--text);
    background: #151b2c;
    box-shadow: inset 2px 0 0 var(--signal);
  }
  .content {
    flex: 999 1 520px;
    min-width: 0;
    max-width: var(--doc-width, 780px);
    padding: 40px 0 80px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .crumb {
    font: 13px var(--font-mono);
    color: var(--faint);
  }
  .crumb span {
    color: var(--muted);
  }
  h1 {
    font-size: clamp(34px, 5vw, 44px);
  }
  .intro {
    font-family: var(--doc-font, var(--font-body));
    font-size: calc(var(--doc-size, 16px) + 2px);
    line-height: var(--doc-leading, 1.7);
    letter-spacing: var(--doc-track, normal);
    word-spacing: var(--doc-word, normal);
    color: var(--muted);
  }
  .toc {
    flex: 1 1 180px;
    max-width: 220px;
    padding: 40px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    position: sticky;
    top: 72px;
    align-self: flex-start;
  }
  .toc .group-title {
    padding: 0 0 4px;
  }
  .toc a {
    color: var(--muted);
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 32px;
  }
  .pager a {
    flex: 1 1 240px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--text);
  }
  .pager a span {
    font-size: 13px;
    color: var(--muted);
  }
  .pager .next {
    align-items: flex-end;
    text-align: right;
  }
  .pager > span {
    flex: 1 1 240px;
  }
  .edit {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .side,
    .toc {
      max-width: none;
      padding-bottom: 0;
    }
    .toc {
      display: none;
    }
  }

  /* Reading settings (ReadingHead.astro) drive these variables; sizes inside
     are in em so headings, code and tables scale with the text. */
  .prose {
    display: flex;
    flex-direction: column;
    gap: 1em;
    color: var(--soft);
    font-family: var(--doc-font, var(--font-body));
    font-size: var(--doc-size, 16px);
    line-height: var(--doc-leading, 1.7);
    letter-spacing: var(--doc-track, normal);
    word-spacing: var(--doc-word, normal);
  }
  .prose :global(h2) {
    margin-top: 1.5em;
    font-size: 1.6em;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .prose :global(h3) {
    margin-top: 0.75em;
    font-size: 1.2em;
    color: var(--text);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .prose :global(:not(pre) > code) {
    font-size: 0.9em;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 5px;
    padding: 1px 5px;
  }
  .prose :global(pre) {
    margin: 0;
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--panel) !important;
    overflow-x: auto;
    font-size: 0.875em;
    line-height: 1.6;
    letter-spacing: normal;
    word-spacing: normal;
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875em;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    background: var(--surface);
    color: var(--muted);
    font-weight: 500;
  }
  .prose :global(td:first-child code) {
    color: var(--signal);
    white-space: nowrap;
  }
  .prose :global(blockquote) {
    margin: 0;
    padding: 14px 18px;
    border: 1px solid var(--signal-deep);
    border-radius: 12px;
    background: rgba(79, 227, 200, 0.05);
  }
  .prose :global(strong) {
    color: var(--text);
  }
</style>
