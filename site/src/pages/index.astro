---
import Base from "../layouts/Base.astro";
import InstallTabs from "../components/InstallTabs.astro";
import SceneCard from "../components/SceneCard.astro";
import Naming from "../components/Naming.astro";
import { siteUrl } from "../site";
import { VERSION } from "../version";

const BW_AGENT = "https://bitwarden.com/help/ssh-agent/";

const audiences = [
  {
    title: "Homelab and Proxmox admins",
    text: "Dozens of nodes, containers and VMs, one key each. bwsshd keeps every host block in step with the vault, no hand-edited config.",
    icon: '<rect x="3" y="3" width="18" height="7" rx="1.5"></rect><rect x="3" y="14" width="18" height="7" rx="1.5"></rect><path d="M7 6.5h.01M7 17.5h.01M11 6.5h6M11 17.5h6"></path>',
  },
  {
    title: "Ops on hardened servers",
    text: "Security baselines such as the CIS benchmarks cap MaxAuthTries at 4 or less. One pinned key per host means one attempt, not a lockout.",
    icon: '<path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"></path><rect x="9" y="11" width="6" height="5" rx="1"></rect><path d="M10.5 11V9.5a1.5 1.5 0 0 1 3 0V11"></path>',
  },
  {
    title: "Teams sharing keys in Bitwarden",
    text: "Bitwarden and Vaultwarden organizations can share SSH key items. Everyone gets the same host mapping from the same item names.",
    icon: '<circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20a6.5 6.5 0 0 1 13 0"></path><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8"></path><path d="M18 14.5a6.5 6.5 0 0 1 3.5 5.5"></path>',
  },
  {
    title: "People with more than one machine",
    text: "Desktop and laptop, Linux, macOS or Windows: the vault syncs the keys, and bwsshd rebuilds the same config on each machine in minutes.",
    icon: '<rect x="2" y="4" width="14" height="10" rx="1.5"></rect><path d="M6 18h6M9 14v4"></path><rect x="17.5" y="8" width="4.5" height="12" rx="1"></rect><path d="M19.75 17h.01"></path>',
  },
];

const features = [
  {
    title: "One key per host",
    text: "Each host block pins a single identity with IdentitiesOnly, so SSH never burns attempts.",
    icon: '<circle cx="8" cy="15" r="4"></circle><path d="M10.8 12.2 20 3"></path><path d="m16 7 3 3"></path>',
  },
  {
    title: "Never on disk",
    text: "Only the .pub lands on disk, to name the key. Signing stays in the Bitwarden app, with its approval prompt.",
    icon: '<rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path>',
  },
  {
    title: "Watches and cleans up",
    text: "Rewrites only when the key set changes. Close Bitwarden and the config is emptied, the key folder removed.",
    icon: '<path d="M21 12a9 9 0 1 1-3-6.7"></path><path d="M21 4v5h-5"></path>',
  },
  {
    title: "Finds the agent",
    text: "Native, Flatpak and Snap sockets on Linux, the .dmg and App Store sockets on macOS, the OpenSSH named pipe on Windows.",
    icon: '<rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8"></path><path d="M12 16v4"></path>',
  },
  {
    title: "Safe by default",
    text: "Atomic 0600 writes, a marker-owned key folder, no symlinks followed, and it refuses to run as root.",
    icon: '<path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z"></path><path d="m9 12 2 2 4-4"></path>',
  },
  {
    title: "Cloud or Vaultwarden",
    text: "The socket comes from the desktop app, so the backend does not matter. Bitwarden cloud and self-hosted both work.",
    icon: '<path d="M17.5 19a4.5 4.5 0 1 0-1.4-8.8A6 6 0 0 0 4.5 12 3.5 3.5 0 0 0 6 19z"></path>',
  },
];

const compare = [
  ["Keys offered to a server", "Exactly one, pinned", "One, if you keep the block right", "All of them, in no host-aware order"],
  ["Private key on disk", "Never", "Often, unless you export .pub files yourself", "Never"],
  ["Adding a key", "Name it in Bitwarden, done", "Export the .pub, edit the config", "Nothing, until MaxAuthTries bites"],
  ["When Bitwarden is closed", "Config emptied, key folder removed", "Stale blocks stay behind", "No keys offered"],
];
---

<Base title="bwsshd: one SSH key per host, straight from your Bitwarden vault">
  <section id="install" class="hero dots" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="badge">Bitwarden SSH agent companion</span>
        <h1 id="hero-title">One key per host.<br />Straight from your vault.</h1>
        <p class="hero-lead">
          bwsshd watches the Bitwarden desktop SSH agent and writes a per-host <code class="inline-code">ssh_config</code>,
          so SSH offers the right key first, every time. Private keys never touch disk.
        </p>
        <InstallTabs />
        <p class="prereq">
          Needs the Bitwarden desktop app with its SSH agent enabled. <a href="#setup">Set it up in three steps</a>, or
          read <a href={BW_AGENT}>Bitwarden's SSH Agent guide</a>.
        </p>
        <ul class="facts" aria-label="Platforms">
          <li>Linux</li><li>macOS</li><li>Windows</li><li aria-hidden="true" class="sep">|</li><li>x86_64 + arm64</li><li
            aria-hidden="true"
            class="sep">|</li
          ><li>MIT</li>
        </ul>
      </div>
      <div class="hero-scene" data-scene-card>
        <div class="stage" data-stage data-scene="hero">
          <img
            class="still"
            src="/stills/hero.svg"
            alt="Isometric scene: the Bitwarden vault feeds bwsshd, which sends a single key to the matching server"
            width="600"
            height="390"
          />
        </div>
        <span class="hint">drag to orbit, hover to inspect</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="problem-title">
    <div class="wrap split">
      <div class="split-copy">
        <span class="eyebrow reject">The problem</span>
        <h2 id="problem-title">Your agent offers every key. Hardened servers stop listening at three.</h2>
        <p class="lead">
          The Bitwarden agent holds all your keys and offers them in no host-aware order. With <code class="inline-code"
            >MaxAuthTries 3</code
          >, SSH runs out of attempts before it reaches the right one.
        </p>
        <p class="lead">
          bwsshd reads the key list, pins one key per host with <code class="inline-code">IdentitiesOnly yes</code>, and
          keeps it current as your vault changes.
        </p>
      </div>
      <div class="terms">
        <pre class="term bad"><span class="dim">without bwsshd</span>
<span class="p">$</span> ssh pve1.example.com
Received disconnect from 203.0.113.10 port 22:2: Too many authentication failures
<span class="p">Disconnected from 203.0.113.10 port 22</span></pre>
        <pre class="term good"><span class="dim">with bwsshd</span>
<span class="p">$</span> bwsshd --watch
bwsshd: wrote ~/.ssh/config.automatic.bw: 12 host(s), 1 key(s) without a hostname
<span class="p">$</span> ssh pve1.example.com
<span class="p">debian@pve1:~$</span></pre>
      </div>
    </div>

    <div class="wrap split devices">
      <div class="terms">
        <pre class="term good"><span class="dim">new laptop, a few minutes later</span>
<span class="p">$</span> curl -fsSL {siteUrl("/install.sh")} | sh
bwsshd: installed {VERSION} to /home/you/.local/bin/bwsshd
bwsshd: running as a systemd user service; logs: journalctl --user -u bwsshd -f
<span class="p">$</span> ssh pve1.example.com
<span class="p">debian@pve1:~$</span></pre>
      </div>
      <div class="split-copy">
        <span class="eyebrow">And on every machine</span>
        <h3 class="sub">Same keys on the desktop and the laptop.</h3>
        <p class="lead">
          Your SSH keys live in the vault, so they already follow you to every device where Bitwarden runs.{" "}
          The <code class="inline-code">ssh_config</code> did not: on each machine you copied{" "}
          <code class="inline-code">.pub</code> files and rewrote <code class="inline-code">Host</code> blocks by hand,
          and they drifted apart.
        </p>
        <p class="lead">
          With bwsshd, a new machine is the desktop app plus one install line. The config rebuilds itself from the vault,
          and a key renamed on one device updates the config on all of them.
        </p>
      </div>
    </div>
  </section>

  <section id="who" class="section" aria-labelledby="who-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Who it's for</span>
        <h2 id="who-title">For people whose SSH keys already live in Bitwarden.</h2>
      </div>
      <div class="who">
        {
          audiences.map((a) => (
            <div class="who-card">
              <span class="who-icon">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={a.icon}
                />
              </span>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </div>
          ))
        }
      </div>
      <p class="not-for">
        <strong>Probably not for you</strong> if your keys sit in <code class="inline-code">~/.ssh</code> with a handful of
        hosts, or if you use Bitwarden without the desktop app: the SSH agent only runs there.
      </p>
    </div>
  </section>

  <section id="setup" class="section dots" aria-labelledby="setup-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Setup</span>
        <h2 id="setup-title">From vault to <code class="inline-code">ssh</code> in three steps.</h2>
        <p class="lead">
          The first two happen in Bitwarden and are covered by <a href={BW_AGENT}>Bitwarden's SSH Agent guide</a>;
          the <a href="/docs/bitwarden-setup/">setup page</a> sums up what bwsshd needs.
        </p>
      </div>
      <ol class="steps">
        <li>
          <span class="num">1</span>
          <h3>Enable the SSH agent</h3>
          <p>
            In the Bitwarden desktop app, open <strong>Settings</strong> and turn on <strong>Enable SSH agent</strong>.
            On Windows, also set the <strong>OpenSSH Authentication Agent</strong> service to Disabled.
          </p>
          <a href={`${BW_AGENT}#enable-ssh-agent`}>Bitwarden: Enable SSH Agent</a>
        </li>
        <li>
          <span class="num">2</span>
          <h3>Add and name your keys</h3>
          <p>
            Create or import SSH key items, and name each one after the host it opens, like <code class="inline-code"
              >debian@pve1.example.com</code
            >.
          </p>
          <a href="https://bitwarden.com/help/about-ssh/#create-a-new-ssh-key">Bitwarden: Create an SSH key</a>
        </li>
        <li>
          <span class="num">3</span>
          <h3>Install bwsshd</h3>
          <p>
            Run the one-liner above. It installs the binary and starts <code class="inline-code">bwsshd --watch</code> at
            login. Then plain <code class="inline-code">ssh pve1.example.com</code> offers one key.
          </p>
          <a href="/docs/install/">All install options</a>
        </li>
      </ol>
    </div>
  </section>

  <section id="how" class="section" aria-labelledby="how-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2 id="how-title">Three scenes, one idea.</h2>
        <p class="lead">Each scene is a small 3D model. Drag to orbit, hover any block to see what it is.</p>
      </div>
      <div class="scenes">
        <SceneCard
          scene="without"
          step="01 / without"
          title="Every key, in any order"
          tone="reject"
          alt="Three keys fly from a laptop to a server and are rejected"
        >
          The agent offers key after key. Three misses and the server hangs up.
        </SceneCard>
        <SceneCard
          scene="with"
          step="02 / with bwsshd"
          title="One key, one try"
          alt="The vault feeds bwsshd, which sends one key to the server"
        >
          bwsshd maps each key name to a host block. SSH asks the vault to sign with exactly that key.
        </SceneCard>
        <SceneCard
          scene="lifecycle"
          step="03 / lifecycle"
          title="Follows your vault"
          toggle
          alt="The vault with its key folder populated"
        >
          Close Bitwarden and bwsshd empties the config and removes its key folder. Open it and everything comes back.
        </SceneCard>
      </div>
    </div>
  </section>

  <Naming />

  <section id="features" class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Features</span>
        <h2 id="features-title">Small daemon, careful defaults.</h2>
      </div>
      <div class="features">
        {
          features.map((f) => (
            <div class="feature">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={f.icon}
              />
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="compare" class="section" aria-labelledby="compare-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Compare</span>
        <h2 id="compare-title">bwsshd, a hand-written config, or the agent alone?</h2>
      </div>
      <div class="table-box">
        <table>
          <thead>
            <tr>
              <th scope="col">Question</th>
              <th scope="col" class="us">bwsshd</th>
              <th scope="col">Hand-written ssh_config</th>
              <th scope="col">Agent alone</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.map(([q, us, manual, agent]) => (
                <tr>
                  <th scope="row">{q}</th>
                  <td>{us}</td>
                  <td class="other">{manual}</td>
                  <td class="other">{agent}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="cta dots" aria-labelledby="cta-title">
    <div class="wrap cta-inner">
      <h2 id="cta-title">Stop guessing which key SSH will try.</h2>
      <p class="lead">Free and open source under MIT. One static binary, no runtime.</p>
      <div class="cta-actions">
        <a class="btn btn-primary" href="#install">Install bwsshd</a>
        <a class="btn" href="/docs/" target="_blank" rel="noopener">Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { mountScenesLazily } from "../iso/lazy";
  mountScenesLazily();
</script>

<style>
  .hero {
    border-bottom: 1px solid var(--hairline);
    overflow: hidden;
  }
  .hero-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    padding-top: 80px;
    padding-bottom: 88px;
  }
  .hero-copy {
    flex: 1 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .badge {
    align-self: flex-start;
    font: 12px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--signal);
    border: 1px solid var(--signal-deep);
    background: rgba(79, 227, 200, 0.06);
    border-radius: 999px;
    padding: 4px 12px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .hero-lead {
    max-width: 540px;
    font-size: 18px;
    color: var(--muted);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    font: 13px var(--font-mono);
    color: var(--muted);
  }
  .facts .sep {
    color: #4e5772;
  }
  .hero-scene {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .hero-scene .stage {
    aspect-ratio: 600 / 390;
    max-width: 640px;
  }
  .hint {
    font: 12px var(--font-mono);
    color: var(--faint);
  }

  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }
  .split-copy {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .split-copy h2 {
    font-size: clamp(30px, 4vw, 40px);
  }
  .devices {
    margin-top: 80px;
  }
  .sub {
    font-size: clamp(24px, 3vw, 30px);
  }
  .eyebrow.reject {
    color: var(--reject);
  }
  .terms {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .term {
    margin: 0;
    padding: 20px;
    border-radius: 12px;
    font-size: 13px;
    line-height: 1.8;
    /* Long log lines wrap instead of scrolling sideways. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    background-image: linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 100% 3px;
  }
  .term .dim {
    color: var(--faint);
  }
  .bad {
    border: 1px solid #3a2a12;
    background-color: #120f0a;
  }
  .bad .p {
    color: var(--reject);
  }
  .good {
    border: 1px solid var(--signal-deep);
    background-color: #0a1513;
  }
  .good .p {
    color: var(--signal);
  }

  .prereq {
    max-width: 580px;
    font-size: 14px;
    color: var(--muted);
  }

  .who {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }
  .who-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .who-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--signal);
    border: 1px solid var(--signal-deep);
    background: rgba(79, 227, 200, 0.06);
    margin-bottom: 4px;
  }
  .who-card h3 {
    font-size: 19px;
  }
  .who-card p {
    color: var(--muted);
    font-size: 15px;
  }
  .not-for {
    margin-top: 24px;
    max-width: 760px;
    color: var(--muted);
    font-size: 15px;
  }
  .not-for strong {
    color: var(--text);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .steps li {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .steps .num {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--signal-deep);
    color: var(--signal);
    font: 600 14px var(--font-mono);
  }
  .steps h3 {
    font-size: 19px;
  }
  .steps p {
    color: var(--muted);
    font-size: 15px;
  }
  .steps p strong {
    color: var(--text);
    font-weight: 600;
  }
  .steps a {
    margin-top: auto;
    font-size: 14px;
  }

  .scenes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--hairline);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .feature {
    background: var(--panel);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--signal);
  }
  .feature h3 {
    font-size: 19px;
    color: var(--text);
  }
  .feature p {
    color: var(--muted);
    font-size: 15px;
  }

  .table-box {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 15px;
  }
  thead tr {
    background: var(--surface);
    text-align: left;
  }
  th,
  td {
    padding: 16px 20px;
    text-align: left;
    border-bottom: 1px solid var(--hairline);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-weight: 600;
    border-bottom-color: var(--line);
  }
  thead th:first-child {
    color: var(--muted);
    font-weight: 500;
  }
  .us {
    color: var(--signal);
    font-family: var(--font-mono);
  }
  tbody th {
    font-weight: 500;
  }
  .other {
    color: var(--muted);
  }

  .cta-inner {
    padding-top: 112px;
    padding-bottom: 112px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .cta h2 {
    font-size: clamp(34px, 5vw, 52px);
    letter-spacing: -0.035em;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
</style>
