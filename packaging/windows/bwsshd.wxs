<!--
  Per-user MSI (no administrator rights): copies bwsshd.exe to
  %LOCALAPPDATA%\Programs\bwsshd and runs `bwsshd install`, which registers the
  logon task. Built by the release workflow with WiX 5:

    wix build packaging/windows/bwsshd.wxs -arch x64 -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d Bin=path/to/bwsshd.exe -o bwsshd.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="bwsshd" Manufacturer="Dxsk" Version="$(var.Version)"
           UpgradeCode="0E0626D1-7176-4C7C-A113-8C60ACF08758"
           Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of bwsshd is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Dxsk/bwsshd" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="bwsshd" />
      </Directory>
    </StandardDirectory>

    <!-- A per-user component needs an HKCU key path and removes the folders
         it creates in the profile. -->
    <Component Id="Main" Directory="INSTALLFOLDER">
      <File Id="BwsshdExe" Source="$(var.Bin)" KeyPath="no" />
      <RegistryValue Root="HKCU" Key="Software\bwsshd" Name="installed" Type="integer"
                     Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
    </Component>

    <!-- The running daemon locks its exe: end the task before Windows
         Installer checks for files in use. -->
    <Property Id="WixQuietExecCmdLine" Value="&quot;[SystemFolder]schtasks.exe&quot; /End /TN bwsshd" />
    <CustomAction Id="StopTask" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />

    <SetProperty Id="RegisterTask" Value="&quot;[#BwsshdExe]&quot; install" Before="RegisterTask"
                 Sequence="execute" />
    <CustomAction Id="RegisterTask" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="check" />

    <SetProperty Id="RemoveTask" Value="&quot;[#BwsshdExe]&quot; uninstall" Before="RemoveTask"
                 Sequence="execute" />
    <CustomAction Id="RemoveTask" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopTask" Before="InstallValidate" />
      <Custom Action="RemoveTask" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RegisterTask" After="InstallFiles" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
